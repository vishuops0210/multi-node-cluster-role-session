global
    log /dev/log local0
    maxconn 2048

defaults
    mode tcp
    timeout connect 5s
    timeout client 30s
    timeout server 30s

frontend kubernetes
    bind *:6443
    mode tcp
    option tcplog
    default_backend kubernetes-api

backend kubernetes-api
    mode tcp
    balance roundrobin
    option tcp-check
{% for host in groups['control_plane'] %}
    server {{ host }} {{ hostvars[host]['ansible_host'] }}:6443 check inter 5s fall 3 rise 2
{% endfor %}
